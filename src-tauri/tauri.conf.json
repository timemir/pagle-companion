{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pagle Companion",
  "mainBinaryName": "pagle-companion",
  "version": "0.0.0",
  "identifier": "app.pagle.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "publisher": "Pagle",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/timemir/pagle-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey":"dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQjMxNTEyMDJENjE5QjAKUldTd0dkWUNFaFd6WEg0VnNpazNMOVpXUWVaUnEvTE96TWN0NG5JUVFOaytReURnVEtVNnE5blgK"
    }
  }
}
